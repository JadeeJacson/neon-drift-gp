config_version=5

[application]

config/name="07-car-soccer NEON LEAGUE"
config/description="霓虹联赛：街机载具足球（火箭联盟 lite）。game-lab 正式期第 07 作。"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7")
config/icon="res://icon.svg"

[audio]

