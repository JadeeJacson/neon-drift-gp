# 引擎与工具：体积大，不入版本控制，仅保留说明
engines/*
!engines/README.md

# 依赖
node_modules/
.venv/
__pycache__/
*.pyc

# 构建产物
dist/
build/
out/
*.pck

# Godot 工程缓存
.godot/
*.import.bak

# Unity 工程缓存
Library/
Temp/
Obj/
Logs/
UserSettings/
*.csproj
*.sln

# Blender 备份
*.blend1
*.blend2

# 编辑器
.vscode/
.idea/

# 临时与日志
_scratch/
_tmp/
*.log

# AI 助手运行时数据（内容与 docs/ 重复，不作权威记录）
.workbuddy/
.workbuddy-ai/

# 文件备份（修复过程中产生的 *.bak-YYYYMMDD 临时副本）
*.bak-*

# 素材原始压缩包（体积大、可由 SOURCES.md 重新下载）
# 用 /* 而非 / 结尾，才能对单个文件做例外放行：polypizza-index.json 是断点重下的依据
assets/_downloads/*
!assets/_downloads/polypizza-index.json
